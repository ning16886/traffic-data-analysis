# 依赖与构建产物
node_modules/
dist/
.vite/

# 本地临时文件
*.local
.DS_Store
Thumbs.db

# 环境变量本地覆盖
.env

# 需求文档与数据集：默认不进仓库，点名放行的才进。
# 写法必须是 /docs/* 而不是 /docs/ —— 目录整体被忽略时，git 不会走进去找文件，
# 里面单条 ! 放行是不生效的。
/data/*
!/data/raw/
# data/raw 里进仓库的是明文 .csv；.csv.gz 只是本地备份，同一份内容不重复入库
data/raw/*.csv.gz
/docs/*
!/docs/项目需求markdown版.md
!/docs/项目演示结果.mp4

# Python 运行产物
__pycache__/
*.pyc

# 后端运行期落盘的数据不上传，只保留空目录
/backend/out/
/backend/data/uploads/*
!/backend/data/uploads/.gitkeep
/backend/traffic.db
/backend/traffic.db-wal
/backend/traffic.db-shm
/backend/traffic.db-journal

# 本地运行日志与临时文件不上传
*.tmp

# 另一个 AI 工具在本目录留下的草稿/记忆文件，不是项目代码
.workbuddy/
